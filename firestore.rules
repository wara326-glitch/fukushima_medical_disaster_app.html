rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)); }
    function enabledAdmin() { return signedIn() && profile().data.enabled == true; }
    function canEdit() { return enabledAdmin() && profile().data.role in ['editor','admin']; }
    function isAdmin() { return enabledAdmin() && profile().data.role == 'admin'; }

    match /reports/{reportId} {
      allow create: if false; // Public writes ONLY through Cloud Function/Admin SDK.
      allow read: if enabledAdmin();
      allow update: if canEdit();
      allow delete: if isAdmin();
    }
    match /admin_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false; // server-side only
    }
    match /{document=**} { allow read, write: if false; }
  }
}
